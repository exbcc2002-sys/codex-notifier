<Window x:Class="CodexNotifier.Desktop.ClosePrompt"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#FAF8F1" Foreground="#171717" FontFamily="Segoe UI, Microsoft YaHei UI"
 Title="关闭 Codex Notifier" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Icon="Assets/app.ico">
 <StackPanel Margin="26">
  <TextBlock Text="关闭主面板后…" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <RadioButton x:Name="MinimizeChoice" GroupName="CloseAction" IsChecked="True" Foreground="#171717" FontSize="15" Content="最小化到系统托盘（默认）"/>
  <TextBlock Text="继续接收通知，保留当前悬浮球设置。" Foreground="#171717" Margin="20,7,0,20"/>
  <RadioButton x:Name="ExitChoice" GroupName="CloseAction" Foreground="#171717" FontSize="15" Content="退出程序"/>
  <TextBlock Text="停止通知并关闭悬浮球。" Foreground="#171717" Margin="20,7,0,24"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True"/>
   <Button x:Name="ConfirmButton" Content="确定" IsDefault="True" Click="Confirm" Background="#DCE9D9" Margin="0"/>
  </StackPanel>
 </StackPanel>
</Window>
